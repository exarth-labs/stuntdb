# Editor settings shared by everyone. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab
